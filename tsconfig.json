{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "declaration": false,
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "typeRoots": [
      "./.millennium/types",
      "./node_modules/@types"
    ],
    "paths": {
      "millennium": [
        "./.millennium/lsp/ts"
      ]
    }
  },
  "include": [
    "**/*",
    ".millennium/**/*.d.ts"
  ]
}
